{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts --turbopack",
    "dev:docker": "docker-compose --profile dev up app",
    "dev:docker:stop": "docker-compose --profile dev down",
    "dev:all": "docker-compose --profile dev up",
    "build": "next build",
    "build:clean": "rd /s /q .next",
    "build:rebuild": "npm run build:clean && npm run build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "start:prod": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose --profile dev --profile prod down",
    "docker:clean": "docker-compose --profile dev --profile prod down --rmi local --volumes",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:app": "docker-compose logs -f app",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:restart": "docker-compose restart",
    "docker:build": "docker-compose build",
    "db:setup": "npm run docker:up && npx prisma generate && npm run db:migrate:docker",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:docker": "bash prisma-docker.sh migrate",
    "db:seed": "npx prisma db seed",
    "db:seed:docker": "bash prisma-docker.sh seed",
    "db:studio": "prisma studio",
    "db:studio:docker": "bash prisma-docker.sh studio",
    "db:push": "prisma db push",
    "db:push:docker": "bash prisma-docker.sh push",
    "db:reset": "npx prisma migrate reset",
    "db:reset:docker": "bash prisma-docker.sh reset",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vitalets/google-translate-api": "^9.2.1",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-intersection-observer": "^10.0.3",
    "shadcn": "^4.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "translate": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "maintained node versions"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.module.css"
  ]
}