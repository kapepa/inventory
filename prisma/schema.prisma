generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========
enum Role {
  USER
  ADMIN
}

enum Money {
  UAH
  USD
}

enum ProductStatus {
  FREE
  BUSY
  REPAIR
}

// ========== USERS ==========
model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  role              Role               @default(USER)
  verifiedAt        DateTime?          @map("verified_at")
  verificationCodes VerificationCode[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  imageUrl          String?            @map("image_url")
  parishes          UserParish[]
  products          Product[]

  @@map("users")
}

model VerificationCode {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  code      String
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  @@index([email])
  @@index([token])
  @@map("verification_codes")
}

// ========== PARISHES ==========
model Parish {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deliveryDate DateTime? @map("delivery_date")

  users        UserParish[]
  products     Product[]
  translations ParishTranslation[]

  @@map("parishes")
}

// Junction table for many-to-many relationship between Users and Parishes
model UserParish {
  userId   String @map("user_id")
  parishId String @map("parish_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@id([userId, parishId])
  @@map("user_parishes")
}

// ========== PARISH TRANSLATIONS (RU, EN) ==========
model ParishTranslation {
  id          String  @id @default(uuid())
  parishId    String  @map("parish_id")
  locale      String
  title       String
  description String?

  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([parishId, locale])
  @@map("parish_translations")
}

// ========== CATEGORIES ==========
model Category {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products     Product[]
  translations CategoryTranslation[]

  @@map("categories")
}

// ========== CATEGORY TRANSLATIONS (RU, EN) ==========
model CategoryTranslation {
  id         String @id @default(uuid())
  categoryId String @map("category_id")
  locale     String
  title      String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

// ========== PRODUCTS ==========
model Product {
  id           String        @id @default(uuid())
  serialNumber String        @unique @map("serial_number")
  isNew        Boolean       @default(true) @map("is_new")
  status       ProductStatus @default(FREE)
  photo        String?
  order        Int?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Foreign Keys
  categoryId String? @map("category_id")
  parishId   String? @map("parish_id")
  userId     String? @map("user_id")

  // Relationships
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parish       Parish?              @relation(fields: [parishId], references: [id], onDelete: SetNull)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  rental       Rental?
  prices       Price[]
  translations ProductTranslation[]

  @@map("products")
}

// ========== PRODUCT TRANSLATIONS (RU, EN) ==========
model ProductTranslation {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  locale        String
  title         String
  specification String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

// ========== RENTALS ==========
model Rental {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("rentals")
}

// ========== PRICES ==========
model Price {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  value     Float
  symbol    Money    @default(UAH)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, symbol])
  @@map("prices")
}
